{
    "openapi": "3.0.3",
    "info": {
        "version": "1.0.0",
        "title": "Marianne Moore Notebooks – Custom API",
        "description": "This is the place to add your own path endpoints"
    },
    "servers": [
        {
            "description": "Endpoint for testing on localhost",
            "url": "/exist/apps/moore"
        }
    ],
    "components": {
        "securitySchemes": {
            "basicAuth": {
                "type": "http",
                "scheme": "basic"
            },
            "cookieAuth": {
                "type": "apiKey",
                "name": "teipublisher.com.login",
                "in": "cookie"
            }
        }
    },
    "tags": [],
    "paths": {
    	"/api/metadata/{id}": {
			"get": {
				"summary": "Retrieve formatted metadata of document",
				"description": "Retrieve formatted metadata of document, transformed via ODD",
				"tags": ["documents"],
				"operationId": "custom:metadata",
				"parameters": [
					{
						"name": "id",
						"in": "path",
						"required": true,
						"schema": {
							"type": "string",
							"example": "test/kant_rvernunft_1781.TEI-P5.xml"
						}
					}
				],
				"responses": {
					"200": {
						"description": "Returns formatted metadata of document",
						"content": {
							"text/html": {
								"schema": {
									"type": "string"
								}
							}
						}
					},
					"404": {
						"description": "Document not found",
						"content": {
							"application/json": {
								"schema": {
									"type": "object"
								}
							}
						}
					}
				}
			}
		},
    	"/api/sections/{id}": {
			"get": {
				"summary": "Retrieve a formatted table of contents for the section the document belongs to",
				"description": "Retrieve a formatted table of contents for the section the document belongs to, transformed via ODD",
				"tags": ["documents"],
				"operationId": "custom:sections",
				"parameters": [
					{
						"name": "id",
						"in": "path",
						"required": true,
						"schema": {
							"type": "string",
							"example": "test/kant_rvernunft_1781.TEI-P5.xml"
						}
					},
					{
						"name": "odd",
						"in": "query",
						"schema": {
							"type": "string",
							"default": "about.odd"
						}
					},
					{
						"name": "target",
						"in": "query",
						"schema": {
							"type": "string"
						},
						"description": "The target channel into which link selection events should be send (if the user clicks on a link)"
					},
					{
						"name": "icons",
						"in": "query",
						"schema": {
							"type": "boolean",
							"default": true
						},
						"description": "Should an expand/collapse icon be displayed next to headings having nested child sections?"
					},
					{
						"name": "If-Modified-Since",
						"in": "header",
						"schema": {
							"type": "string"
						}
					}
				],
				"responses": {
					"200": {
						"description": "Returns a formatted list of sections",
						"content": {
							"text/html": {
								"schema": {
									"type": "string"
								}
							}
						}
					},
					"404": {
						"description": "Document not found",
						"content": {
							"application/json": {
								"schema": {
									"type": "object"
								}
							}
						}
					}
				}
			}
		},
		"/api/toc-by-page/{id}": {
			"get": {
				"summary": "Retrieve a formatted table of contents for the document",
				"description": "Retrieve a formatted table of contents for the document, transformed via ODD",
				"tags": ["documents"],
				"operationId": "custom:toc-pages",
				"parameters": [
					{
						"name": "id",
						"in": "path",
						"required": true,
						"schema": {
							"type": "string",
							"example": "test/kant_rvernunft_1781.TEI-P5.xml"
						}
					},
					{
						"name": "odd",
						"in": "query",
						"schema": {
							"type": "string",
							"example": "teipublisher.odd"
						}
					},
					{
						"name": "view",
						"in": "query",
						"schema": {
							"type": "string",
							"enum": ["page", "div", "single"]
						},
						"example": "div",
						"description": "The view type used by the main view which displays the document, e.g. 'page' or 'div'. This has an influence on the generated links, which need to differ when linking to a page rather than a section."
					},
					{
						"name": "target",
						"in": "query",
						"schema": {
							"type": "string"
						},
						"description": "The target channel into which link selection events should be send (if the user clicks on a link)"
					},
					{
						"name": "icons",
						"in": "query",
						"schema": {
							"type": "boolean",
							"default": true
						},
						"description": "Should an expand/collapse icon be displayed next to headings having nested child sections?"
					},
					{
						"name": "If-Modified-Since",
						"in": "header",
						"schema": {
							"type": "string"
						}
					}
				],
				"responses": {
					"200": {
						"description": "Returns the formatted table of contents as HTML",
						"content": {
							"text/html": {
								"schema": {
									"type": "string"
								}
							}
						}
					},
					"404": {
						"description": "Document not found",
						"content": {
							"application/json": {
								"schema": {
									"type": "object"
								}
							}
						}
					}
				}
			}
		},
		"/api/table/{id}": {
            "get": {
                "summary": "Data for table",
                "description": "Data for table",
				"tags": ["view"],
                "operationId": "custom:table",
                "parameters": [
					{
						"name": "id",
						"in": "path",
						"required": true,
						"schema": {
							"type": "string"
						}
					},
					{
						"name": "order",
						"in": "query",
						"schema": {
							"type": "string"
						}
					}
				],
				"responses": {
                    "200": {
                        "description": "List of all people as JSON array",
                        "content": {
                            "application/json": {
                                "schema":{
                                    "type": "array"
                                }
                            }
                        }
                    }
				}
			}			
		}
    },
    "security": [
        {
            "cookieAuth": []
        },
        {
            "basicAuth": []
        }
    ]
}